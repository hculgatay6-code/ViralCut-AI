{
  "name": "viralcut-ai-desktop",
  "version": "21.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "productName": "ViralCut AI Desktop",
  "description": "Yerel video kesme ve otomatik altyazı editörü",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run build && node --test",
    "preview": "vite preview --strictPort",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --x64",
    "lint": "oxlint --deny correctness desktop server scripts src tests vite.config.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "lucide-react": "^1.72.0",
    "onnxruntime-node": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "oxlint": "1.93.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch@7 - 10": "11.0.8"
  }
}
